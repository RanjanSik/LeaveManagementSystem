@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Admin Dashboard</h1>
        <p class="text-muted mb-0">Overview of employees and leave activity</p>
    </div>
    <a class="btn btn-outline-primary" asp-controller="Leaves" asp-action="Index" asp-route-status="@LeaveStatus.Pending">
        Review Pending
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Total Employees</div>
                <div class="display-6">@Model.TotalEmployees</div>
                <div class="small text-success">@Model.ActiveEmployees active</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Pending</div>
                <div class="display-6 text-warning">@Model.PendingRequests</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Approved</div>
                <div class="display-6 text-success">@Model.ApprovedRequests</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Rejected</div>
                <div class="display-6 text-danger">@Model.RejectedRequests</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Filters</h2>
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Department</label>
                <select name="department" class="form-select">
                    <option value="">All departments</option>
                    @foreach (var dept in Model.Departments)
                    {
                        if (Model.DepartmentFilter == dept)
                        {
                            <option value="@dept" selected>@dept</option>
                        }
                        else
                        {
                            <option value="@dept">@dept</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (LeaveStatus s in Enum.GetValues(typeof(LeaveStatus)))
                    {
                        if (Model.StatusFilter == s)
                        {
                            <option value="@s" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">From</label>
                <input type="date" name="fromDate" class="form-control"
                       value="@(Model.FromDateFilter?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label">To</label>
                <input type="date" name="toDate" class="form-control"
                       value="@(Model.ToDateFilter?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Apply</button>
                <a class="btn btn-outline-secondary" asp-action="Admin">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Leave Requests</h2>
            <span class="text-muted small">Showing up to 50 matching records</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Days</th>
                        <th>Status</th>
                        <th>Reviewed By</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.RecentRequests.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No leave requests match the current filters.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.RecentRequests)
                    {
                        <tr>
                            <td>@item.Employee?.FullName</td>
                            <td>@(item.Employee?.Department ?? "-")</td>
                            <td>@item.FromDate.ToString("dd MMM yyyy")</td>
                            <td>@item.ToDate.ToString("dd MMM yyyy")</td>
                            <td>@item.DurationDays</td>
                            <td>
                                <span class="badge status-@item.Status.ToString().ToLowerInvariant()">@item.Status</span>
                            </td>
                            <td>
                                @if (item.ReviewedBy != null)
                                {
                                    <div>@item.ReviewedBy.FullName</div>
                                    <div class="small text-muted">@item.ReviewedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (item.Status == LeaveStatus.Pending)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Leaves" asp-action="Review" asp-route-id="@item.Id">Review</a>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
