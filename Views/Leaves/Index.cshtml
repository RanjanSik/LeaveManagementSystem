@model IEnumerable<LeaveRequest>
@{
    ViewData["Title"] = "Leave Requests";
    LeaveStatus? status = ViewBag.Status as LeaveStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Leave Requests</h1>
        <p class="text-muted mb-0">Approve or reject pending employee leave requests</p>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (LeaveStatus s in Enum.GetValues(typeof(LeaveStatus)))
            {
                if (status == s)
                {
                    <option value="@s" selected>@s</option>
                }
                else
                {
                    <option value="@s">@s</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="card-body table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Days</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Audit</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">No leave requests found.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Employee?.FullName</td>
                        <td>@(item.Employee?.Department ?? "-")</td>
                        <td>@item.FromDate.ToString("dd MMM yyyy")</td>
                        <td>@item.ToDate.ToString("dd MMM yyyy")</td>
                        <td>@item.DurationDays</td>
                        <td>@item.Reason</td>
                        <td><span class="badge status-@item.Status.ToString().ToLowerInvariant()">@item.Status</span></td>
                        <td>
                            @if (item.ReviewedBy != null)
                            {
                                <div>@item.ReviewedBy.FullName</div>
                                <div class="small text-muted">@item.ReviewedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                            }
                            else
                            {
                                <span class="text-muted">Not reviewed</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (item.Status == LeaveStatus.Pending)
                            {
                                <a class="btn btn-sm btn-primary" asp-action="Review" asp-route-id="@item.Id">Review</a>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
