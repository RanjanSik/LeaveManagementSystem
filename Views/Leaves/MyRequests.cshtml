@model IEnumerable<LeaveRequest>
@{
    ViewData["Title"] = "My Leave Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">My Leave Requests</h1>
    <a class="btn btn-primary" asp-action="Apply">Apply for Leave</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>From</th>
                    <th>To</th>
                    <th>Days</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th>Reviewed</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No leave requests yet.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FromDate.ToString("dd MMM yyyy")</td>
                        <td>@item.ToDate.ToString("dd MMM yyyy")</td>
                        <td>@item.DurationDays</td>
                        <td>@item.Reason</td>
                        <td><span class="badge status-@item.Status.ToString().ToLowerInvariant()">@item.Status</span></td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td>
                            @if (item.ReviewedBy != null)
                            {
                                <div>@item.ReviewedBy.FullName</div>
                                <div class="small text-muted">@item.ReviewedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
